pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- fish

function _init()
	player = {
	 y = 64,
		x = 64,
		left = false
	}
	bubbles = {}
	
	tick = 0
	music(1)
end

function _update()
	update_game()
end

function _draw()
	draw_game()
end
-->8
-- draw game

function draw_game()
	cls()
	draw_bubbles()
	spr(1, player.x, player.y, 1, 1, player.left)
end

function draw_bubbles()
	for b in all(bubbles) do
		circ(b.x, b.y, b.r, 7)
	end
end
-->8
-- update game

function update_game()
	if btn(⬅️) then
		player.x -= 1
		player.left = true
	end
	if btn(➡️) then
		player.x += 1
		player.left = false
	end
	if (btn(⬆️)) player.y -= 1
	if (btn(⬇️)) player.y += 1
	
	update_bubbles()
	
	tick += 1
end

function update_bubbles()
	for b in all(bubbles) do
		b.y -= 1
		b.r -= .02
		b.ttl -= 1
		if (b.ttl == 0) del(bubbles,b)
	end

	if (tick % 32 == 0) then
		local x = player.x
		if (not player.left) x += 8
		
		add(bubbles, {
			x = x,
			y = player.y,
			r = rnd(2) + 1,
			ttl = 64
		})
		end
end
