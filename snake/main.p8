pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- snake

function _init()	
	tick_max = 4 -- game speed
	size_max = 32 -- win condition
	dist_min = 12 -- distance between menu arrows

	menu = {}
	initialize_menu()

	player = {}
	initialize_player()

	state_game = false
	state_lose = false
	state_win = false
	message_printed = false
	tick = 0

	place_food()
	
	music(0)
end

function _update()
	if state_game then
		update_game()
	else
		update_title()
	end
end

function _draw()
	if state_game then
		draw_game()
	else
		draw_title()
	end
end
-->8
-- draw game

function draw(s,mx,my,r)
 local x,y = mx * 8, my * 8
 local sx = (s % 16) * 8
	local sy = flr(s / 16) * 8
	
	for i = 0,7 do
		for j = 0,7 do
		 local col = sget(sx+i,sy+j)
		 if col ~= 0 then
		 	if (r == 0) spr(s,x,y)
		 	if (r == 1) pset(x+7-j, y+i, col)
		 	if (r == 2) pset(x+7-i, y+7-j, col)
		 	if (r == 3) pset(x+j, y+7-i, col)
		 end
		end
	end
end

-- lifecycle

function draw_game()
	cls()
	map()
	
	-- draw food
	spr(7,food.x*8,food.y*8)
		
	-- draw snake
	for i=1,#player.body do
	
		if i == 1 then
			draw(3, player.body[i].x, player.body[i].y, player.body[i].r)
		elseif i == #player.body then
			draw(5, player.body[i].x, player.body[i].y, player.body[i - 1].r)
		else
			local s = 4 
			local r = player.body[i].r
			local r_next = player.body[i - 1].r
			if r ~= r_next then
			 s = 6
			 if ((r - r_next + 4) % 4 == 1) r = (r + 1) % 4
			end
			draw(s, player.body[i].x, player.body[i].y, r)
		end
	end
end
-->8
-- update game

function check_gameover()
	if (state_lose or state_win) state_game = false
end

function check_collision()
	local collision_detected = false
	if (
		player.body[1].x >= 16 or
		player.body[1].x < 0 or
		player.body[1].y >= 16 or
		player.body[1].y < 0
	)	then
		collision_detected = true
	end

	for i=2,#player.body do
		if (
			player.body[1].x == player.body[i].x and
			player.body[1].y == player.body[i].y
		) then
			collision_detected = true
		end
	end

	if collision_detected then
	 state_lose = true
	 sfx(1)
	end
end

function check_player_size()
	if #player.body >= size_max then
		state_win = true
		sfx(2)
	end
end

function place_food()
	local x,y
	local placeable
	
	repeat
		x = flr(rnd(16))
		y = flr(rnd(16))
		placeable = true
		
		for i = 1,#player.body do
			if (player.body[i].x == x and player.body[i].y == y) placeable = false
		end
	until placeable

 food = {
 	x = x,
 	y = y
 }
end

-- lifecycle

function update_game()
	check_gameover()

	if (btnp(⬅️) and player.dir ~= 1) player.dir_next = 0
	if (btnp(➡️) and player.dir ~= 0) player.dir_next = 1
	if (btnp(⬆️) and player.dir ~= 3) player.dir_next = 2
	if (btnp(⬇️) and player.dir ~= 2) player.dir_next = 3

 if (tick == tick_max) then
 	tick = 0
 		
 	-- move snake
 	local length = #player.body
 	local tail = {
 		x = player.body[length].x,
 		y = player.body[length].y,
 		r = player.body[length].r
 	}

 	for i=length,2,-1 do
 		player.body[i].x = player.body[i-1].x
 		player.body[i].y = player.body[i-1].y
 		player.body[i].r = player.body[i-1].r
 	end
 	
 	if player.dir_next == 0 then
	 	player.body[1].x -= 1
	 	player.body[1].r = 2
	 elseif player.dir_next == 1 then
	 	player.body[1].x += 1
	 	player.body[1].r = 0
		elseif player.dir_next == 2 then
	 	player.body[1].y -= 1
	 	player.body[1].r = 3
	 else
 	 player.body[1].y += 1
 	 player.body[1].r = 1
	 end
	 
	 -- check for food
	 if player.body[1].x == food.x and player.body[1].y == food.y then
	 	add(player.body, tail)
	 	place_food()
	 	sfx(0)
	 end
	 
 	player.dir = player.dir_next
 	
 	check_collision()
 	check_player_size()
 end

 tick += 1
end
-->8
-- draw title

function draw_title()
	cls()
 map()

 for i = 0,size_max-1 do
 	spr(2,(i % 16) * 8,flr(i / 16) * 8)
 end

 if state_win then
 	print('you have won, cheers!', 20, 32, 10)
	elseif state_lose then
		print('sorry, you have lost...', 20, 32, 10)	
	else
		print('snake by ilyaww', 32, 32, 10)
	end

	local tick_color, size_color = 7,7
	if menu.tick_selected then
		tick_color = 10
	else
	 size_color = 10
	end

	print('animation speed', 16, 80, 7)
	if (menu.tick_selected) print('⬅️', 96 - menu.dist, 80, tick_color)
	print(tick_max, 94, 80, tick_color)
 if (menu.tick_selected)	print('➡️', 96 + menu.dist, 80, tick_color)
 
	print('snake size goal', 16, 88, 7)
	if (not menu.tick_selected) print('⬅️', 96 - menu.dist, 88, size_color)
	print(size_max, 94, 88, size_color)
	if (not menu.tick_selected) print('➡️', 96 + menu.dist, 88, size_color)
	
	print('press 🅾️ to start', 32, 96,7)
	
end
-->8
-- update title

function update_title()
	tick += 1
	
	if (tick == tick_max) then
 	tick = 0
 	menu.dist = (menu.dist - dist_min + 1) % 4 + dist_min
 end
 	

	if btnp(⬅️) then
		if menu.tick_selected then
		 if tick_max > 1 then
		 	tick_max -= 1
		 	tick = 0
		 end
		else
		 if (size_max > 3) size_max -= 1
		end
	end
	
	if btnp(➡️) then
		if menu.tick_selected then
			if tick_max < 16 then
				tick_max += 1
				tick = 0
			end
		else
			if (size_max < 256) size_max += 1
		end
	end
	
 if (btnp(⬇️) or btnp(⬆️)) then
 	sfx(4)
 	menu.tick_selected = not menu.tick_selected
 end
 
 if	(btnp(🅾️)) then
 	sfx(4)
  state_intro = false
 	state_game = true
 	state_lose = false
 	state_win = false
 	message_printed = false
 	tick = 0
 	initialize_player()
 	place_food()
 	initialize_menu()
 end
end
-->8
-- utils

function initialize_player()
	player = {
		dir = 1,
		dir_next = 1,
		body = {
			{x = 2,	y = 7, r = 0},
			{x = 1,	y = 7, r = 0},
			{x = 0,	y = 7, r = 0}
		}
	}
end

function initialize_menu()
 menu = {
 	tick_selected = true,
 	dist = dist_min
 }
end
